{
  "name": "wastemarket",
  "version": "1.0.0",
  "private": true,
  "description": "WasteMarket full-stack application",
  "engines": {
    "node": ">=22.3.0"
  },
  "scripts": {
    "postinstall": "npm ci --prefix server --omit=dev && npm ci --prefix client --include=dev",
    "build": "npm run build --prefix client",
    "start": "npm start --prefix server",
    "test:deployment": "npm run build && node --test tests/deployment.test.js"
  }
}
